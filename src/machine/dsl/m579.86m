schema 1
machine m579 {
    name = "[ALi ALADDiN V] PC Chips M579"
    runtime {
        firmware linear "roms/machines/m579/MS6260S_Socket7_ALi_M1542_AMI.BIN" 0xe0000 131072 0
        platform at.common
        pci config_type_1
        slot 0x00 northbridge route [none, none, none, none]
        slot 0x01 agp_bridge route [A, B, none, none]
        slot 0x07 southbridge route [A, B, C, D]
        slot 0x0f southbridge_ide route [A, B, C, D]
        slot 0x03 southbridge_pmu route [A, B, C, D]
        slot 0x02 southbridge_usb route [A, B, C, D]
        slot 0x10 expansion route [C, D, A, B]
        slot 0x12 expansion route [B, C, D, A]
        slot 0x14 expansion route [A, B, C, D]
        device ali.m1541
        device ali.m1543c
        device flash.sst_29ee010
        spd sdram 0x07 512
    }
}
